{
  "name": "finishing-office-tool",
  "version": "1.0.0",
  "private": true,
  "description": "نظام متابعة العملاء والتسعير — مكتب تشطيبات معماري",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/styles.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --loader:.jsx=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/bundle.js",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "lucide-react": "^1.28.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.23.0",
    "tailwindcss": "^4.3.3"
  }
}
