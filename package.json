{
  "name": "finishing-office-tool",
  "version": "1.0.0",
  "private": true,
  "description": "نظام متابعة العملاء والتسعير — مكتب تشطيبات معماري",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./styles.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --splitting --format=esm --loader:.jsx=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outdir=assets --entry-names=main",
    "build": "npm run build:css && npm run build:js",
    "test": "esbuild test/smoke.mjs --bundle --platform=node --outfile=/tmp/_s.cjs --format=cjs && node /tmp/_s.cjs",
    "test:roles": "esbuild test/roles.mjs --bundle --platform=node --outfile=/tmp/_r.cjs --format=cjs && node /tmp/_r.cjs",
    "test:ui": "esbuild test/render.mjs --bundle --platform=node --loader:.mjs=jsx --outfile=/tmp/_u.cjs --format=cjs && node /tmp/_u.cjs",
    "test:excel": "esbuild test/excel.mjs --bundle --platform=node --outfile=/tmp/_x.cjs --format=cjs && node /tmp/_x.cjs",
    "test:all": "npm run test && npm run test:roles && npm run test:ui && npm run test:excel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "lucide-react": "^1.28.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.23.0",
    "tailwindcss": "^4.3.3"
  }
}